+// Embedder (e.g. CEF) override for permission prompt creation. Mirrors the
+// desktop g_create_permission_prompt_ptr seam in the Views factory
+// (chrome/browser/ui/views/permissions/permission_prompt_factory.cc).
+PermissionPrompt::EmbedderCreatePromptFunction g_embedder_create_prompt_fn =
+    nullptr;
+
+}  // namespace
+
+void PermissionPrompt::SetEmbedderCreatePromptFunction(
+    EmbedderCreatePromptFunction function) {
+  g_embedder_create_prompt_fn = function;
+}
+
 std::unique_ptr<PermissionPrompt> PermissionPrompt::Create(
     content::WebContents* web_contents,
     Delegate* delegate) {
+  // Give an embedder (e.g. CEF's CefPermissionHandler) the first chance to
+  // handle the prompt, before the default Android Java dialog path.
+  if (g_embedder_create_prompt_fn) {
+    bool default_handling = true;
+    auto prompt = g_embedder_create_prompt_fn(web_contents, delegate,
+                                              &default_handling);
+    if (prompt) {
+      return prompt;
+    }
+    if (!default_handling) {
+      return nullptr;
+    }
+  }
