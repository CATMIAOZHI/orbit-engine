+  // allocates (BionicAllocator on Android), which is the very reentrancy this
+  // guards against. Mutable because the method it guards is const.
+  mutable bool subsampling_in_progress_ = false;
+
   RingBuffer<LockMetricSample, kMaxSamples> unified_sample_buffer_;
 
   // Include the subsampler in the thread-local data to avoid reallocations
