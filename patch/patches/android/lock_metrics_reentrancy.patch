diff --git base/synchronization/lock_metrics_recorder.cc base/synchronization/lock_metrics_recorder.cc
index 3e2533316ef2a..cf3f3f7e935f4 100644
--- base/synchronization/lock_metrics_recorder.cc
+++ base/synchronization/lock_metrics_recorder.cc
@@ -154,6 +154,26 @@ void LockMetricsRecorder::ReportLockHistogram(const LockMetricSample& sample) {
 
 bool LockMetricsRecorder::ShouldRecordLockAcquisitionTime() const {
   DCHECK(CalledOnValidThread());
+  // Re-entrancy guard. subsampler_.ShouldSample() lazily seeds its
+  // InsecureRandomGenerator on first use via base::RandUint64() -> BoringSSL
+  // RAND_bytes -> malloc (see the comment on
+  // InsecureRandomGenerator::RandUint64(), which keeps the seeding lazy on
+  // purpose so that *construction* stays allocator-safe). Under
+  // PartitionAlloc-Everywhere that allocation can take a contended
+  // SpinningMutex, whose ScopedLockAcquisitionTimer calls back into this method
+  // before the seed completes -> unbounded recursion -> stack overflow
+  // (observed intermittently during process startup on Android). On re-entry,
+  // skip sampling so the nested allocation records no metric and the seed can
+  // complete.
+  //
+  // The flag is a member, not a `thread_local`: this object is already
+  // per-thread, and constraint 1 above forbids allocating here -- a
+  // `thread_local`'s first access does allocate (BionicAllocator on Android),
+  // which would reintroduce the very recursion this guards against.
+  if (subsampling_in_progress_) {
+    return false;
+  }
+  const AutoReset<bool> guard(&subsampling_in_progress_, true);
   return !iterating_in_progress_ && subsampler_.ShouldSample(kSamplingRatio);
 }
 
