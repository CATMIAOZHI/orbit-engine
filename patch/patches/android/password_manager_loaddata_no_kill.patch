diff --git components/password_manager/content/browser/bad_message.cc components/password_manager/content/browser/bad_message.cc
index c70453c66825a..f2b923d6a7abe 100644
--- components/password_manager/content/browser/bad_message.cc
+++ components/password_manager/content/browser/bad_message.cc
@@ -37,12 +37,19 @@ bool CheckForIllegalURL(content::RenderFrameHost* frame,
                         bool may_kill_renderer) {
   if (form_url.SchemeIs(url::kAboutScheme) ||
       form_url.SchemeIs(url::kDataScheme)) {
-    if (may_kill_renderer) {
-      SYSLOG(WARNING)
-          << "Killing renderer: illegal password access from about: "
-          << "or data: URL. Reason: " << static_cast<int>(reason);
-      bad_message::ReceivedBadMessage(frame->GetProcess(), reason);
-    }
+    // CEF/Android: an embedder loadDataWithBaseURL() page commits with a data:
+    // resource URL even though its document origin is the supplied base_url. The
+    // upstream guard terminates the renderer here (passwords on about:/data: URLs
+    // are forbidden as potentially exploitable), but for CEF's loadDataWithBaseURL
+    // that is a false positive -- it kills the renderer and blanks the surface,
+    // since the chrome PasswordManager never encounters this WebView-style API in
+    // ordinary Chrome. DENY the password operation (return false, exactly as
+    // before) but do NOT terminate the process: the op is already refused, so the
+    // security guarantee holds (a compromised renderer gains nothing) without
+    // crashing a legitimate embedder-loaded page. (151's may_kill_renderer gate is
+    // intentionally bypassed here to guarantee no kill for the CEF loadData case.)
+    SYSLOG(WARNING) << "Ignoring (not killing) password access from about:/data: "
+                    << "URL. Reason: " << static_cast<int>(reason);
     return false;
   }
 
