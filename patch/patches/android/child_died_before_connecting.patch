+    // Android delivers no ServiceConnection callback when the service's process
+    // dies before the service is created, in the app's Application.onCreate()
+    // for example: the binding stays pending and the launch never completes or
+    // fails. The exit records do show that death; treat it as the child dying.
+    private void checkDiedBeforeConnecting() {
+        assert isRunningOnLauncherThread();
+        if (mDidOnServiceConnected || mServiceDisconnected || mConnectionController.isUnbound()) {
+            return;
+        }
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return;
+        ApplicationExitInfo died = findExitSinceBind();
+        if (died != null) {
+            Log.e(
+                    TAG,
+                    "%s died before it connected: exit reason %d (%s). If the app has its own"
+                            + " Application class, it ran in this process too.",
+                    died.getProcessName(),
+                    died.getReason(),
+                    died.getDescription());
+            onServiceDisconnectedOnLauncherThread();
+            return;
+        }
+        if (System.currentTimeMillis() - mBindTimeMs < START_CRASH_POLL_LIMIT_MS) {
+            mLauncherHandler.postDelayed(this::checkDiedBeforeConnecting, START_CRASH_POLL_MS);
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.R)
+    private @Nullable ApplicationExitInfo findExitSinceBind() {
+        Context context = ContextUtils.getApplicationContext();
+        try {
+            if (mServiceProcessName == null) {
+                mServiceProcessName =
+                        context.getPackageManager()
+                                .getServiceInfo(assumeNonNull(mBoundServiceName), 0)
+                                .processName;
+            }
+            List<ApplicationExitInfo> exits =
+                    assumeNonNull(context.getSystemService(ActivityManager.class))
+                            .getHistoricalProcessExitReasons(null, 0, 16);
+            for (ApplicationExitInfo info : exits) {
+                String name = info.getProcessName();
+                int reason = info.getReason();
+                if (info.getTimestamp() >= mBindTimeMs
+                        && (name.equals(mServiceProcessName)
+                                || name.startsWith(mServiceProcessName + ":"))
+                        && (reason == ApplicationExitInfo.REASON_CRASH
+                                || reason == ApplicationExitInfo.REASON_CRASH_NATIVE
+                                || reason == ApplicationExitInfo.REASON_INITIALIZATION_FAILURE)) {
+                    return info;
+                }
+            }
+        } catch (Exception e) {
+            // No answer: keep waiting, as without this check.
+        }
+        return null;
+    }
