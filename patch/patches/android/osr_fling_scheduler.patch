+void FlingSchedulerAndroid::OnAnimationStep(base::TimeTicks timestamp) {
+  CHECK(observed_ui_compositor_, base::NotFatalUntil::M152);
+  if (fling_controller_)
+    fling_controller_->ProgressFling(timestamp);
+}
+
+void FlingSchedulerAndroid::OnCompositingShuttingDown(
+    ui::Compositor* compositor) {
+  CHECK_EQ(observed_ui_compositor_, compositor, base::NotFatalUntil::M152);
+  RemoveAnimationObserver();
+}
+
+void FlingSchedulerAndroid::RemoveAnimationObserver() {
+  if (!observed_ui_compositor_)
+    return;
+  observed_ui_compositor_->RemoveAnimationObserver(this);
+  observed_ui_compositor_ = nullptr;
