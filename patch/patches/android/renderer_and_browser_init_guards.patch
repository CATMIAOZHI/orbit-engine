     : parent_(parent) {
   JNIEnv* env = base::android::AttachCurrentThread();
+  // Check if the Java class exists before calling. In CEF/embedder mode,
+  // Chrome-specific Java classes may not be present.
+  jclass clazz = env->FindClass(
+      "org/chromium/chrome/browser/ui/browser_window/"
+      "GlobalBrowserCollectionPlatformDelegate");
+  if (!clazz || env->ExceptionCheck()) {
+    if (env->ExceptionCheck()) env->ExceptionClear();
+    return;
+  }
+  env->DeleteLocalRef(clazz);
   j_delegate_.Reset(Java_GlobalBrowserCollectionPlatformDelegate_create(
       env, reinterpret_cast<int64_t>(this)));
 }
 
