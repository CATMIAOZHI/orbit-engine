diff --git a/chrome/browser/password_manager/chrome_password_manager_client.cc b/chrome/browser/password_manager/chrome_password_manager_client.cc
index 359122a985..f203432ed3 100644
--- a/chrome/browser/password_manager/chrome_password_manager_client.cc
+++ b/chrome/browser/password_manager/chrome_password_manager_client.cc
@@ -142,6 +142,7 @@
 #if BUILDFLAG(IS_ANDROID)
 #include "base/android/device_info.h"
 #include "chrome/browser/android/tab_android.h"
+#include "components/android_autofill/browser/autofill_provider.h"
 #include "chrome/browser/android/tab_web_contents_delegate_android.h"
 #include "chrome/browser/keyboard_accessory/android/manual_filling_controller.h"
 #include "chrome/browser/keyboard_accessory/android/password_accessory_controller.h"
@@ -456,6 +457,18 @@ void ChromePasswordManagerClient::FocusedInputChanged(
   if (GetProfilePasswordStore() == nullptr) {
     return;
   }
+
+  // When an embedder (e.g., CEF) uses AndroidAutofillManager instead of
+  // BrowserAutofillManager, Chrome's keyboard accessory UI is not available.
+  // ManualFillingController, PaymentMethodAccessoryController, and
+  // PasswordGenerationController require Chrome's Android UI infrastructure
+  // (JNI bindings to keyboard accessory views). Skip the entire password
+  // accessory flow when AutofillProvider is present (indicating Android
+  // platform autofill is active).
+  if (autofill::AutofillProvider::FromWebContents(web_contents())) {
+    return;
+  }
+
   ManualFillingController::GetOrCreate(web_contents())
       ->NotifyFocusedInputChanged(focused_field_id, focused_field_type);
   GetOrCreatePasswordAccessory()->UpdateCredManReentryUi(focused_field_type);
