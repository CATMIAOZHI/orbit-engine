@@ -132,6 +132,13 @@ public abstract class FeatureMap {
     }
 
     public boolean queryFeatureValueFromNative(String featureName) {
+        // Return false (disabled) if the native FeatureList is not yet
+        // initialized. This happens in CEF, where Java code queries features
+        // during early initialization, before FeatureList::SetInstance is
+        // called. Guarding here rather than in isEnabledInNative() covers every
+        // path that would otherwise reach native too early; this method is the
+        // only one that touches it.
+        if (!FeatureList.isNativeInitialized()) return false;
         ensureNativeMapInit();
         return FeatureMapJni.get().isEnabled(mNativeMapPtr, featureName);
     }
