diff --git base/test/BUILD.gn base/test/BUILD.gn
index 26e6931..e8ab8d2 100644
--- base/test/BUILD.gn
+++ base/test/BUILD.gn
@@ -675,7 +675,12 @@ target(_target_type, "test_trace_processor") {
     "//third_party/abseil-cpp:absl",
