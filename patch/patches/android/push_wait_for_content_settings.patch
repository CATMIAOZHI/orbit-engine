+void PushMessagingServiceImpl::OnContentSettingsUpToDate() {
+  content_settings_up_to_date_ = true;
+  std::queue<PendingMessage> messages;
+  std::swap(messages, messages_waiting_for_content_settings_);
+  while (!messages.empty()) {
+    OnMessage(messages.front().app_id, messages.front().message);
+    messages.pop();
+  }
+}
