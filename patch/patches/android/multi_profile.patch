diff --git chrome/browser/profiles/profile_impl.cc chrome/browser/profiles/profile_impl.cc
--- chrome/browser/profiles/profile_impl.cc
+++ chrome/browser/profiles/profile_impl.cc
@@ -141,6 +141,7 @@
 #include "components/keyed_service/core/simple_keyed_service_factory.h"
 #include "components/language/core/browser/pref_names.h"
 #include "components/language/core/common/locale_util.h"
+#include "components/leveldb_proto/public/proto_database_provider.h"
 #include "components/metrics/metrics_service.h"
 #include "components/omnibox/browser/autocomplete_classifier.h"
 #include "components/payments/core/payment_request_metrics.h"
@@ -537,9 +538,23 @@ ProfileImpl::ProfileImpl(
 
 #if BUILDFLAG(IS_ANDROID)
   auto* startup_data = g_browser_process->startup_data();
-  DCHECK(startup_data && startup_data->GetProfileKey());
-  TakePrefsFromStartupData();
-  async_prefs = false;
+  if (startup_data && startup_data->GetProfileKey()) {
+    TakePrefsFromStartupData();
+    async_prefs = false;
+  } else {
+    // The startup data belongs to the first profile and has been taken. An
+    // embedder that creates another disk profile loads its prefs the way
+    // every other platform does, synchronously as the first profile is here:
+    // the embedder may create a browser on it right away.
+    async_prefs = false;
+    LoadPrefsForNormalStartup(async_prefs);
+    // Services keyed on the ProfileKey (built with the profile) need its proto
+    // database provider before the storage partition exists; StartupData sets
+    // it up the same way for the first profile.
+    proto_db_provider_ = std::make_unique<leveldb_proto::ProtoDatabaseProvider>(
+        GetPath(), /*is_in_memory=*/false);
+    key_->SetProtoDatabaseProvider(proto_db_provider_.get());
+  }
 #else
   LoadPrefsForNormalStartup(async_prefs);
 #endif
@@ -1512,6 +1527,9 @@ ProfileImpl::TakeDefaultProtoDatabaseProvider() {
 #if BUILDFLAG(IS_ANDROID)
   // On Android StartupData creates proto database provider for the profile
   // before profile is created, so move ownership to storage partition.
+  if (proto_db_provider_) {
+    return std::move(proto_db_provider_);
+  }
   return g_browser_process->startup_data()->TakeProtoDatabaseProvider();
 #else
   return nullptr;
diff --git chrome/browser/chrome_browser_main_android.cc chrome/browser/chrome_browser_main_android.cc
index 91ca9fcee02c9..7e896fa227ae0 100644
--- chrome/browser/chrome_browser_main_android.cc
+++ chrome/browser/chrome_browser_main_android.cc
@@ -62,8 +62,12 @@ int ChromeBrowserMainPartsAndroid::PreCreateThreads() {
 
 void ChromeBrowserMainPartsAndroid::PostProfileInit(Profile* profile,
                                                     bool is_initial_profile) {
-  DCHECK(is_initial_profile);  // No multiprofile on Android, only the initial
-                               // call should happen.
+  if (!is_initial_profile) {
+    // An embedder's additional disk profile. Chrome on Android has only the
+    // initial one, and the process-wide setup below already ran with it.
+    ChromeBrowserMainParts::PostProfileInit(profile, is_initial_profile);
+    return;
+  }
 
   // Get the OS Data Saver setting. This will be needed later on, so we want to
   // fetch this setting as soon as possible to avoid blocking on it.
diff --git chrome/browser/profiles/profile_impl.h chrome/browser/profiles/profile_impl.h
index 5fd22e22cbfe5..ec1e247cd4140 100644
--- chrome/browser/profiles/profile_impl.h
+++ chrome/browser/profiles/profile_impl.h
@@ -305,6 +305,13 @@ class ProfileImpl : public Profile {
   // SimpleKeyedServiceFactory.
   std::unique_ptr<ProfileKey> key_;
 
+#if BUILDFLAG(IS_ANDROID)
+  // Proto database provider of a disk profile other than the first, created
+  // with its key as StartupData does for the first one; handed to the default
+  // storage partition by TakeDefaultProtoDatabaseProvider().
+  std::unique_ptr<leveldb_proto::ProtoDatabaseProvider> proto_db_provider_;
+#endif
+
 #if BUILDFLAG(IS_CHROMEOS)
   std::unique_ptr<ash::Preferences> chromeos_preferences_;
 
