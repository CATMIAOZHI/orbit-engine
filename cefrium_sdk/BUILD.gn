# Cefrium SDK — Android AAR package.
#
# Build targets:
#   cefrium_jni_registration — GEN_JNI class with all JNI bindings
#   cefrium_aar              — raw AAR (large, all resources)
#   cefrium_sdk              — optimized AAR (stripped locales, compressed)
#
# The final deliverable is cefrium-sdk.aar in $root_build_dir.

import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

android_resources("cefrium_resources") {
  sources = []
}

android_library("cefrium_java") {
  testonly = true
  sources = [
    "java/src/com/cefrium/Cefrium.java",
    "java/src/com/cefrium/CefriumBrowser.java",
    "java/src/com/cefrium/CefriumRenderHandler.java",
    "java/src/com/cefrium/CefriumSurfaceContainer.java",
    "java/src/org/chromium/build/BuildConfig.java",
    "java/src/org/chromium/build/NativeLibraries.java",
    "java/src/org/jni_zero/GEN_JNI.java",
    # R classes for Chromium packages are generated by the Cefrium
    # Gradle Plugin in the consumer project. Do NOT include them here.
  ]
  deps = [
    ":cefrium_resources",
    "//base:base_java",
    "//components/embedder_support/android:content_view_java",
    "//components/embedder_support/android:view_java",
    "//components/android_autofill/browser:java",
    "//components/webauthn/android:java",
    "//content/public/android:content_java",
    "//third_party/androidx:androidx_core_core_java",
    "//ui/android:ui_java",
  ]
}

# Aggregate Java dependencies for JNI method scanning.
# This collects all Java classes with @NativeMethods annotations
# that need native bindings in GEN_JNI.
java_group("cefrium_jni_java_deps") {
  testonly = true
  deps = [
    ":cefrium_java",
    "//base:base_java",
    "//chrome/android:chrome_all_java",
    "//components/embedder_support/android:view_java",
    "//content/public/android:content_java",
    "//mojo/public/java:system_java",
    "//net/android:net_java",
    "//third_party/jni_zero:jni_zero_java",
    "//ui/android:ui_java",
  ]
}

# Generate JNI registration (GEN_JNI class) for all Java→native bindings
# used by libcef.so. This is SDK infrastructure, NOT test code.
# testonly is required because libcef depends on libcef_test_support (upstream).
generate_jni_registration("cefrium_jni_registration") {
  testonly = true
  java_targets = [ ":cefrium_jni_java_deps" ]
  native_deps = [ "//cef:libcef" ]

  # CEF includes Chrome native code but not all Chrome Java classes.
  # add_stubs generates no-op stubs for missing JNI methods (patched
  # in gen_jni_java.py to return defaults instead of throwing).
  # remove_uncalled strips bindings the build thinks are unused.
  add_stubs_for_missing_jni = true
  remove_uncalled_jni = true
}

# Chromium/CEF runtime resources bundled into the AAR. Without these the
# embedded engine aborts at startup ("Failed to open pak file" -> SIGTRAP in
# nativeInitialize). Declaring them as deps of the AAR makes it self-contained
# and reproducible per architecture: the AAR no longer relies on a prior
# cefrium_test_apk build having left the .pak files in root_out_dir (which
# silently produced a broken AAR on a fresh x64 build).
android_assets("cefrium_assets") {
  testonly = true
  sources = [
    "$root_out_dir/resources.pak",
    "$root_out_dir/chrome_100_percent.pak",
    "$root_out_dir/chrome_200_percent.pak",
  ]
  renaming_sources = [ "$root_out_dir/locales/en-US.pak" ]
  renaming_destinations = [ "stored-locales/en-US.pak" ]
  disable_compression = true
  deps = [
    "//cef:cef_pak_android",
    "//cef:cef_100_percent_pak_android",
    "//cef:cef_200_percent_pak_android",
    "//cef:cef_locale_en_us_android",
    "//gin:v8_snapshot_assets",
    "//third_party/icu:icu_assets",
  ]
}

dist_aar("cefrium_aar") {
  testonly = true
  deps = [
    ":cefrium_assets",
    ":cefrium_java",
    ":cefrium_jni_registration",
    "//cef:libcef",
    "//chrome/android:chrome_all_java",
    "//components/embedder_support/android:view_java",
    "//content/public/android:content_java",
    "//net/android:net_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
  output = "$root_build_dir/cefrium-raw.aar"
  native_libraries = [ "$root_build_dir/libcef.so" ]
  android_manifest = "AndroidManifest.xml"
  proguard_configs = [ "proguard.txt" ]
  jar_excluded_patterns = [ "META-INF/*" ]
}

# Post-process AAR: strip locale resources, compress everything.
action("cefrium_sdk") {
  testonly = true
  script = "slim_aar.py"
  deps = [
    ":cefrium_aar",
    "//cef:libcef",
  ]
  inputs = [ "$root_build_dir/cefrium-raw.aar" ]
  outputs = [ "$root_build_dir/cefrium-sdk.aar" ]
  args = [
    "--input",
    rebase_path("$root_build_dir/cefrium-raw.aar", root_build_dir),
    "--output",
    rebase_path("$root_build_dir/cefrium-sdk.aar", root_build_dir),
  ]
}
