# Cefrium SDK — Android AAR package.
#
# Build targets:
#   cefrium_jni_registration — GEN_JNI class with all JNI bindings
#   cefrium_aar              — raw AAR (large, all resources)
#   cefrium_sdk              — optimized AAR (stripped locales, compressed)
#
# The final deliverable is cefrium-sdk.aar in $root_build_dir.

import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

android_resources("cefrium_resources") {
  # FEATURE-038 / Option A: define the string resources that the AAR's vendored
  # Material/Preference/Cast/MediaRouter styles reference but the fat AAR never
  # bundles, so a Maven consumer resolves them without needing those libraries as
  # dependencies (which would otherwise duplicate the vendored classes). This file
  # existed but was never wired in (sources was empty) — the orphaned root cause.
  sources = [
    "res/values/compat_strings.xml",
    # Google Play services common strings — the fat AAR vendors play-services
    # classes (FirebaseApp / FCM) but not their resources; gms.common code reads
    # them by R.string id (FEATURE-041).
    "res/values/play_services_strings.xml",
    "res/xml/cefrium_file_paths.xml",
  ]
}

