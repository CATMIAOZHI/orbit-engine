<?xml version="1.0" encoding="utf-8"?>
<!-- Cefrium SDK AndroidManifest.
     Merged into the consuming app's manifest automatically by Gradle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cefrium">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Chromium's network stack queries connectivity at startup
         (DataSaverOSSetting.isDataSaverEnabled -> ConnectivityManager, and
         NetworkChangeNotifier). Without this a SecurityException is thrown and,
         being uncaught across the JNI boundary, is fatal. Declared by the SDK so
         consumers inherit it via manifest merging. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- F5: lock-screen / shade media controls (CefriumMediaSession). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WebAuthn / passkeys via the Android Credential Manager (Android 14+).
         The engine routes navigator.credentials through CredMan and requests
         credentials on behalf of the page's web origin (RP), which requires
         CREDENTIAL_MANAGER_SET_ORIGIN. Without it CredentialManager throws an
         uncaught SecurityException that is fatal across the JNI boundary (same
         class as ACCESS_NETWORK_STATE above). Declared by the SDK so consumers
         inherit it via manifest merging — no consumer action, no crash on
         passkey pages. Normal protection level (auto-granted). -->
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_SET_ORIGIN" />
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_QUERY_CANDIDATE_CREDENTIALS" />

    <!-- FEATURE-059: external URL scheme hand-off. Android 11+ package visibility
         hides other apps unless declared here; without this the browser cannot see
         the apps that handle external schemes (tel:, mailto:, geo:, sms: and app
         deep-links), so queryIntentActivities returns empty and the hand-off finds
         "no app" and silently does nothing. Declared by the SDK so consumers
         inherit VIEW/DIAL/SENDTO/SEND handler visibility via manifest merging. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
        </intent>
    </queries>

    <!-- The app zygote loads libcef.so once and renderers fork from it with
         the library already relocated, as Chrome does: 4 to 8 MB less per
         renderer on a W90. An app with its own zygotePreloadName keeps it
         with tools:replace and loses this. -->
    <application
        android:zygotePreloadName="org.chromium.content_public.app.ZygotePreload">
        <!-- Zero-config init. The framework instantiates this provider at app
             launch (browser process, before any Activity); its onCreate runs the
             per-process Chromium plumbing so consumers need no custom Application
             and no explicit Cefrium.initialize(). The authority is made unique per
             consumer via ${applicationId} (the androidx.startup pattern). -->
        <provider
            android:name="com.cefrium.CefriumInitProvider"
            android:authorities="${applicationId}.cefriuminit"
            android:exported="false"
            android:initOrder="100" />
        <!-- FEATURE-073: Web Push for apps without a FirebaseMessagingService
             of their own. Disabled so it never takes messages from the app's
             own service; an app enables it in its manifest, or calls
             CefriumPush.handleMessage from its own service instead. -->
        <service android:name="com.cefrium.CefriumPushService"
                 android:enabled="false"
                 android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- F5: foreground service hosting the media-playback notification. -->
        <service android:name="com.cefrium.CefriumMediaService"
                 android:foregroundServiceType="mediaPlayback"
                 android:exported="false" />
        <!-- Sandboxed child processes (renderer, utility). 40 slots (Chrome's
             default) so multi-browser use never exhausts the pool: e.g. a
             CefriumBrowserPool of lessons, each with a cross-origin iframe (host +
             iframe = 2 renderers per browser), plus the transient overlap while an
             evicted browser is still closing as the next one spawns. With too few
             slots Chromium must reuse an in-use slot, and on process-per-browser
             devices (HyperOS / Android 16) Android then kills a still-needed
             foreground renderer ("isolated not needed"), crashing the app. -->
        <meta-data android:name="org.chromium.content.browser.NUM_SANDBOXED_SERVICES"
                   android:value="40"/>
        <!-- Cefrium's own child service class names (com.cefrium.ChildServices),
             read by Chromium through patch android/child_service_names. With
             Chromium's default names, a system WebView started anywhere in this
             package bound SandboxedProcessService0 instance 0 first, and Android
             then handed WebView's renderer process to Cefrium: a blank page and
             "Child process's classpath doesn't match" in logcat. -->
        <meta-data android:name="org.chromium.content.browser.SANDBOXED_SERVICES_NAME"
                   android:value="com.cefrium.ChildServices$Sandboxed"/>
        <meta-data android:name="org.chromium.content.browser.NATIVE_SANDBOXED_SERVICES_NAME"
                   android:value="com.cefrium.ChildServices$NativeSandboxed"/>
        <meta-data android:name="org.chromium.content.browser.PRIVILEGED_SERVICES_NAME"
                   android:value="com.cefrium.ChildServices$Privileged"/>
        <!-- android:useAppZygote on service 0, as upstream Chrome declares it.
             Children forked from the app zygote carry the same seccomp set as
             the system WebView's renderers: 4 filters on a W90, against 2
             without it.

             It was held back once because injected mouse and touch stopped
             reaching a windowed renderer after other browsers had run. The
             cause was not the zygote: CefriumBrowser joined its WebContents to
             the window on a fixed 2000 ms timer after the first loadUrl, and
             until then no renderer got a BeginFrame, so none could end paint
             holding and Blink suppressed their non-move input. The zygote only
             starts renderers fast enough to run into that gap. Fixed by
             connecting as soon as the native browser exists
             (onNativeBrowserCreated). -->
        <!-- Android 17+ renderers with no JVM (Chromium's javaless renderers)
             run as com.cefrium.ChildServices$NativeSandboxed0 and 1. They need
             android:nativeService and android:zygotePreloadNativeLib, which a
             build with compileSdk below 37 rejects, so they are not declared
             here: the com.cefrium Gradle plugin adds them when the app compiles
             against 37 or later, and Cefrium keeps renderers on the Java
             services below when they are missing. -->
        <service android:name="com.cefrium.ChildServices$Sandboxed0"
                 android:process=":sandboxed_process0"
                 android:isolatedProcess="true"
                 android:useAppZygote="true"
                 android:exported="false" />
