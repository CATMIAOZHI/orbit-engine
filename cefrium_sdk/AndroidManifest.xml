<?xml version="1.0" encoding="utf-8"?>
<!-- Cefrium SDK AndroidManifest.
     Merged into the consuming app's manifest automatically by Gradle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cefrium">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Chromium's network stack queries connectivity at startup
         (DataSaverOSSetting.isDataSaverEnabled -> ConnectivityManager, and
         NetworkChangeNotifier). Without this a SecurityException is thrown and,
         being uncaught across the JNI boundary, is fatal. Declared by the SDK so
         consumers inherit it via manifest merging. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- F5: lock-screen / shade media controls (CefriumMediaSession). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Google Play services version. The fat AAR vendors Chrome's GMS
             classes (play-services-basement/base); Chromium's WebOTP path
             (SmsProviderGms) calls
             GoogleApiAvailability.isGooglePlayServicesAvailable(), which throws a
             fatal, uncaught GooglePlayServicesMissingManifestValueException unless
             this meta-data is present. Declared here so every consumer inherits it
             via manifest merging — no consumer action needed. The @integer value
             is provided by the AAR's vendored GMS resources. -->
        <meta-data android:name="com.google.android.gms.version"
                   android:value="@integer/google_play_services_version" />
        <!-- F5: foreground service hosting the media-playback notification. -->
        <service android:name="com.cefrium.CefriumMediaService"
                 android:foregroundServiceType="mediaPlayback"
                 android:exported="false" />
        <!-- Sandboxed child processes (renderer, utility) -->
        <meta-data android:name="org.chromium.content.browser.NUM_SANDBOXED_SERVICES"
                   android:value="5"/>
        <service android:name="org.chromium.content.app.SandboxedProcessService0"
                 android:process=":sandboxed_process0"
                 android:isolatedProcess="true"
                 android:exported="false" />
        <service android:name="org.chromium.content.app.SandboxedProcessService1"
                 android:process=":sandboxed_process1"
                 android:isolatedProcess="true"
                 android:exported="false" />
        <service android:name="org.chromium.content.app.SandboxedProcessService2"
                 android:process=":sandboxed_process2"
                 android:isolatedProcess="true"
                 android:exported="false" />
        <service android:name="org.chromium.content.app.SandboxedProcessService3"
                 android:process=":sandboxed_process3"
                 android:isolatedProcess="true"
                 android:exported="false" />
        <service android:name="org.chromium.content.app.SandboxedProcessService4"
                 android:process=":sandboxed_process4"
                 android:isolatedProcess="true"
                 android:exported="false" />

        <!-- Privileged child processes (GPU when out-of-process) -->
        <meta-data android:name="org.chromium.content.browser.NUM_PRIVILEGED_SERVICES"
                   android:value="3"/>
        <service android:name="org.chromium.content.app.PrivilegedProcessService0"
                 android:process=":privileged_process0"
                 android:isolatedProcess="false"
                 android:exported="false" />
        <service android:name="org.chromium.content.app.PrivilegedProcessService1"
                 android:process=":privileged_process1"
                 android:isolatedProcess="false"
                 android:exported="false" />
        <service android:name="org.chromium.content.app.PrivilegedProcessService2"
                 android:process=":privileged_process2"
                 android:isolatedProcess="false"
                 android:exported="false" />
    </application>
</manifest>
