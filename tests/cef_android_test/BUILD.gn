# Cefrium Android test APK.
# Minimal Android app that loads libcef.so, calls CefInitialize,
# and logs the result. Phase 2 test harness.

import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

# Native shared library that bridges Java → CEF C API.
shared_library("libcefrium_test") {
  testonly = true
  sources = [ "cefrium_test_jni.cc" ]

  deps = [
    "//cef:libcef",
    "//base",
    "//content/public/app",
    "//third_party/jni_zero",
  ]

  configs += [ "//cef:libcef_includes_config" ]
  libs = [ "log" ]
  ldflags = [
    "-Wl,--version-script=" +
        rebase_path("libcefrium_test.lst", root_build_dir),
  ]
}

# Generate JNI registration (GEN_JNI class) for all Java→native bindings
# used by the CEF shared library and its dependencies.
generate_jni_registration("cefrium_jni_registration") {
  testonly = true
  java_targets = [ ":cefrium_test_apk" ]
  native_deps = [
    ":libcefrium_test",
    "//cef:libcef",
  ]

  # CEF includes Chrome native code but not all Chrome Java classes.
  # Allow mismatches between native JNI refs and available Java classes.
  # Do NOT use add_stubs_for_missing_jni — stubs use __builtin_trap()
  # in official builds which kills the process. Missing natives will
  # throw UnsatisfiedLinkError at runtime (non-fatal with try/catch).
  add_stubs_for_missing_jni = true
  remove_uncalled_jni = true
}

# Java library for the test activity.
android_library("cefrium_test_java") {
  testonly = true
  sources = [
    "apk/src/org/cefrium/test/CefriumTestActivity.java",
  ]
  deps = [
    "//base:base_java",
    "//ui/android:ui_java",
  ]
}

# Assets: pak files, ICU data, V8 snapshot.
android_assets("cefrium_test_assets") {
  testonly = true
  sources = [
    "$root_out_dir/resources.pak",
    "$root_out_dir/chrome_100_percent.pak",
    "$root_out_dir/chrome_200_percent.pak",
  ]
  renaming_sources = [ "$root_out_dir/locales/en-US.pak" ]
  renaming_destinations = [ "stored-locales/en-US.pak" ]
  disable_compression = true
  deps = [
    "//cef:cef_pak_android",
    "//cef:cef_100_percent_pak_android",
    "//cef:cef_200_percent_pak_android",
    "//cef:cef_locale_en_us_android",
    "//gin:v8_snapshot_assets",
    "//third_party/icu:icu_assets",
  ]
}

# The APK itself.
android_apk("cefrium_test_apk") {
  testonly = true
  apk_name = "CefriumTest"
  android_manifest = "apk/AndroidManifest.xml"

  deps = [
    ":cefrium_test_assets",
    ":cefrium_test_java",
    "//base:base_java",
    "//chrome/android:chrome_all_java",
    "//mojo/public/java:system_java",
    "//content/public/android:content_java",
    "//net/android:net_java",
    "//ui/android:ui_java",
    "//third_party/jni_zero:jni_zero_java",
  ]

  shared_libraries = [ ":libcefrium_test" ]
  srcjar_deps = [ ":cefrium_jni_registration" ]
}
