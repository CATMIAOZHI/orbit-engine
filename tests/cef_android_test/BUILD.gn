# Cefrium Android test APK.
# Minimal Android app that loads libcef.so, calls CefInitialize,
# and logs the result. Phase 2 test harness.

import("//build/config/android/rules.gni")

# Native shared library that bridges Java → CEF C API.
# This library is intentionally minimal — it only contains the JNI
# bridge functions. All Chromium code (including GEN_JNI dispatch)
# lives in libcef.so to avoid duplicate static globals.
shared_library("libcefrium_test") {
  testonly = true
  sources = [ "cefrium_test_jni.cc" ]

  deps = [
    "//cef:libcef",
    "//base",
    "//content/public/app",
    "//third_party/jni_zero",
  ]

  configs += [ "//cef:libcef_includes_config" ]
  libs = [ "log" ]
  ldflags = [
    "-Wl,--version-script=" +
        rebase_path("libcefrium_test.lst", root_build_dir),
  ]
}

# Java library for the test activity.
android_library("cefrium_test_java") {
  testonly = true
  sources = [
    "apk/src/org/cefrium/test/CefriumTestActivity.java",
    "apk/src/org/cefrium/test/CefriumTestApplication.java",
  ]
  deps = [
    "//base:base_java",
    "//ui/android:ui_java",
  ]
}

# Assets: pak files, ICU data, V8 snapshot.
# Runtime resources (.pak/v8/icu) are defined once in the production SDK
# (//cef/cefrium_sdk:cefrium_assets) and reused here — the test depends on
# production, never the reverse.

# The APK itself.
android_apk("cefrium_test_apk") {
  testonly = true
  apk_name = "CefriumTest"
  android_manifest = "apk/AndroidManifest.xml"

  deps = [
    "//cef/cefrium_sdk:cefrium_assets",
    ":cefrium_test_java",
    "//base:base_java",
    "//chrome/android:chrome_all_java",
    "//content/public/android:content_java",
    "//mojo/public/java:system_java",
    "//net/android:net_java",
    "//ui/android:ui_java",
    "//third_party/jni_zero:jni_zero_java",
  ]

  shared_libraries = [ "//cef:libcef" ]

  # Generate non-final R classes so resource IDs are NOT inlined by javac.
  # This is required for AAR distribution — the consumer's AAPT assigns
  # different IDs, and non-final fields resolve correctly at runtime.
  shared_resources = true
  srcjar_deps = [ "//cef/cefrium_sdk:cefrium_jni_registration" ]

  # Enable R8 to shrink unused Java classes from chrome_all_java.
  proguard_enabled = true
  proguard_enable_obfuscation = false  # Keep class names for JNI
  proguard_configs = [ "proguard.flags" ]

  # Minimize Chrome UI resources.
  strip_resource_names = true
  short_resource_paths = true
  aapt_locale_allowlist = [ "en" ]  # Strip all non-English locales
}
