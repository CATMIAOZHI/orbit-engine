<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- FEATURE-032: OS-level location, so a granted web geolocation permission
         can actually reach the provider (CefriumPermissionTest). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Tier F: getUserMedia camera/mic (WebRTC). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- F5: media notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TestHostApplication"
        android:label="Cefrium Instrumentation"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- Chromium multi-process services (renderer/utility/GPU) are
             declared by the Cefrium SDK AAR with the correct slot count
             (40, isolatedProcess=true). Do NOT redeclare
             NUM_SANDBOXED_SERVICES here: a consumer-side count both fails
             the manifest merge (value mismatch) and caps the SDK slots,
             crashing on process-per-browser OEMs (HyperOS). -->

        <!-- Generic Activity host for SDK tests that need an Activity to attach
             a browser surface to. Not exported; launched by instrumentation. -->
        <activity
            android:name=".HostActivity"
            android:exported="false" />
    </application>
</manifest>
